{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "gateway",
          "format": "url",
          "env": "GATEWAY_URL"
        }
      ]
    },
    "gateway": {
      "root": "apps/gateway",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "gateway" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
